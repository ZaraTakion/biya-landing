{
  "name": "biya-parallel-worlds",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "battery:1": "npm run typecheck",
    "battery:2": "vitest run tests/react",
    "battery:3": "npm run build",
    "battery:4": "npm audit --omit=dev --audit-level=high && node scripts/security-audit.mjs",
    "battery:5": "node scripts/release-audit.mjs",
    "verify:five": "npm run battery:1 && npm run battery:2 && npm run battery:3 && npm run battery:4 && npm run battery:5",
    "deploy": "npm run verify:five && wrangler deploy",
    "test:responsive": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "^4.148.0",
    "@types/node": "26.6.4",
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
